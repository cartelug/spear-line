# Copy to .env. Keep .env and data/ out of Git.
HOST=127.0.0.1
PORT=3000
# Default: enquiries can be prepared/downloaded, but cannot be submitted.
ENQUIRIES_ENABLED=false
# Required when enabling submission. Use an HTTPS origin in production.
PUBLIC_ORIGIN=http://localhost:3000
BUSINESS_LEGAL_NAME=
PUBLIC_CONTACT_EMAIL=
# Optional public contact details. Include international dialling code.
PUBLIC_CONTACT_PHONE=
PUBLIC_WHATSAPP=
PUBLIC_ADDRESS=
# Use a persistent private volume. Never point inside public/.
DATA_DIR=./data
NODE_ENV=development
# Set a retention period before enabling enquiries. Establish the daily purge job in README.
RETENTION_DAYS=
# Optional: also POST each stored enquiry (JSON with a text summary) to this webhook. HTTPS is required in production.
# The enquiry details are sent to that service, so list it in your privacy information.
NOTIFY_WEBHOOK_URL=
